{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Follow Analyser",
  "version": "0.1.0",
  "identifier": "dev.followanalyser.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Follow Analyser",
        "width": 960,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "See who doesn't follow you back on Instagram",
    "icon": ["icons/icon.png"]
  }
}
